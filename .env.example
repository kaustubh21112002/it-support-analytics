# Supabase Client Configuration
# Replace these placeholder values with your actual project URL and anon public key.
# Copy this file to .env or .env.local for local development.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Demo Authentication & Simulated Personas Gating
# Controls whether client-side simulated demo personas, OTP bypass, and role-switching are accessible.
#
# Environment defaults:
# - Local development (npm run dev): Enabled by default. Set to 'false' to evaluate production auth UX locally.
# - Production build (npm run build): Disabled by default for security. Must be explicitly set to 'true'
#   if deploying an intentionally public demo showcase.
#
# GOVERNANCE NOTICE:
# Simulated demo personas are client-side UI testing tools only. They DO NOT provide identity verification
# or backend security. Database RLS policies and server-side authorization remain strictly enforced.
VITE_ENABLE_DEMO_AUTH=true

